		{
			"description": "LunarisV: Racist language",
			"sources": [
				"chat",
				"sourcebans"
			],
			"triggers": {
				"chatmsg_text_match": {
					"mode": "regex",
					"case_sensitive": false,
					"patterns": [
						"[\\s\\S]*\\bn[i1!|][g69]{2}[e3]r(?:s)?\\b[\\s\\S]*",
						"[\\s\\S]*\\bn[i1!|][g69]{2}[a4](?:s)?\\b[\\s\\S]*",
						"[\\s\\S]*\\bk[i1]ke(?:s)?\\b[\\s\\S]*",
						"[\\s\\S]*\\b(?:heil\\s+hitler|sieg\\s+heil|white\\s+power)\\b[\\s\\S]*",
						"[\\s\\S]*\\b(?:kill|gas|exterminate)\\s+(?:all\\s+|the\\s+)?(?:jews|blacks|muslims|immigrants)\\b[\\s\\S]*"
					]
				}
			},
			"actions": {
				"mark": [
					"racist"
				]
			}
		},
		{
			"description": "LunarisV: Hostile language",
			"sources": [
				"chat",
				"sourcebans"
			],
			"triggers": {
				"chatmsg_text_match": {
					"mode": "regex",
					"case_sensitive": false,
					"patterns": [
						"[\\s\\S]*\\bf[a4]gg?[o0]t(?:s)?\\b[\\s\\S]*",
						"[\\s\\S]*\\b(?:kill|gas|exterminate)\\s+(?:all\\s+|the\\s+)?gays\\b[\\s\\S]*",
						"[\\s\\S]*\\b(?:kill\\s+yourself|go\\s+kill\\s+yourself|kys)\\b[\\s\\S]*",
						"[\\s\\S]*\\b(?:i(?:\\s+will|\\x27ll|m\\s+going\\s+to)|i\\x27m\\s+going\\s+to)\\s+(?:kill|murder|dox)\\s+(?:you|your\\s+family)\\b[\\s\\S]*"
					]
				}
			},
			"actions": {
				"mark": [
					"hostile"
				]
			}
		},
		{
			"description": "LunarisV: Pedofilia/Pedo Jokes",
			"sources": [
				"chat",
				"sourcebans"
			],
			"triggers": {
				"chatmsg_text_match": {
					"mode": "regex",
					"case_sensitive": false,
					"patterns": [
						"[\\s\\S]*\\b(?:i\\s+am|i\\x27m|im)\\s+(?:a\\s+)?(?:proud\\s+)?(?:pedo(?:phile)?|paedophile)\\b[\\s\\S]*",
						"[\\s\\S]*\\bage\\s+is\\s+just\\s+a\\s+number\\b[\\s\\S]*",
						"[\\s\\S]*\\b(?:i\\s+)?(?:love|like|prefer)\\s+(?:dating|grooming)\\s+(?:kids|children|minors|underage\\s+(?:girls|boys))\\b[\\s\\S]*",
						"[\\s\\S]*\\b(?:legalize|legalise|normalize|normalise)\\s+(?:pedo(?:philia|filia)|paedophilia)\\b[\\s\\S]*",
						"[\\s\\S]*\\b(?:if|when)\\s+(?:her|his|their)\\s+age\\s+is\\s+on\\s+the\\s+clock\\b[\\s\\S]*"
					]
				}
			},
